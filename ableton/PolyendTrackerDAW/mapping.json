    "Fx":          { "press": "device_next" },

    "Copy":        { "press": "copy",                       "shift": "paste" },
    "Insert":      { "press": "re_enable_automation",       "shift": "home" },
    "Delete":      { "press": "delete" },
    "Up":          { "press": "cursor_up",                  "shift": "select_up" },
    "Down":        { "press": "cursor_down",                "shift": "select_down" },
