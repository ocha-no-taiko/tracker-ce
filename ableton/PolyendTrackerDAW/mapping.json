{
  "channel": 16,
  "buttonCcBase": 20,
  "jogCc": 70,
  "helloCc": 119,
  "padNoteBase": 36,

  "feedback": {
    "stateCcBase": 100,
    "tempoMsbCc": 110,
    "tempoLsbCc": 111,
    "ringTrackCc": 112,
    "ringSceneCc": 113,
    "selectedTrackCc": 114
  },

  "ledValues": {
    "stopped": 6,
    "playing": 31,
    "triggered": 63,
    "recording": 52,
    "triggeredToRecord": 42,
    "armedEmpty": 2
  },

  "buttons": {
    "Play":        { "press": "play_toggle",                "shift": "continue" },
    "Rec":         { "press": "arrangement_record",         "shift": "session_record" },

    "Params":      { "press": "automation_mode" },
    "Performance": { "press": "toggle_session_arrangement" },
    "File":        { "press": "toggle_browser" },
    "Config":      { "press": "open_settings" },
    "Master":      { "press": "toggle_main_devices" },

    "Note":        { "press": "toggle_clip_view" },
    "Instr":       { "press": "toggle_device_view" },
    "Vol":         { "press": "device_prev" },
    "Fx":          { "press": "device_next" },

    "Copy":        { "press": "copy",                       "shift": "paste" },
    "Insert":      { "press": "re_enable_automation",       "shift": "home" },
    "Delete":      { "press": "delete" },
    "Up":          { "press": "cursor_up",                  "shift": "ring_page_up" },
    "Down":        { "press": "cursor_down",                "shift": "ring_page_down" },
    "Left":        { "press": "cursor_left",                "shift": "ring_page_left" },
    "Right":       { "press": "cursor_right",               "shift": "ring_page_right" },

    "Screen1":     { "press": "track_activator" },
    "Screen2":     { "press": "solo_selected_track" },
    "Screen3":     { "press": "arm_selected_track" },
    "Screen4":     { "press": "undo",                       "shift": "redo" },
    "Screen5":     { "press": "redo" },
    "Screen6":     { "press": "metronome",                  "shift": "tap_tempo" },

    "Pattern":     { "press": "undo",                       "shift": "redo" },
